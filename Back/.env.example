# === Variables de entorno para desarrollo local ===

# PostgreSQL (usadas por docker-compose.dev.yml)
DB_USER=postgres
DB_PASSWORD=tu_password_aqui
DB_NAME=crumbs

# Conexión a la base de datos (Prisma)
DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@localhost:5432/${DB_NAME}?schema=public"

# Secret para firmar tokens JWT (OBLIGATORIO - mínimo 32 caracteres)
JWT_SECRET="cambiar-por-un-secret-seguro-generado-con-openssl-rand-base64-32"
