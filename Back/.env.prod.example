# === Variables de entorno para PRODUCCIÓN (AWS) ===
# Copiar este archivo como .env.prod y llenar los valores reales

# Conexión a RDS PostgreSQL
DATABASE_URL="postgresql://crumbs_admin:TU_PASSWORD_SEGURO@tu-instancia.xxxxx.us-east-1.rds.amazonaws.com:5432/crumbs?schema=public"

# Secret JWT (generar con: openssl rand -base64 64)
JWT_SECRET="GENERAR_CON_openssl_rand_base64_64"

# Entorno
NODE_ENV=production
PORT=3000
